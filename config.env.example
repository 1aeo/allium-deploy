# Allium Metrics Deployment Configuration
# ========================================
# Copy this to config.env and edit the values.
# config.env is gitignored - never commit secrets!

# === STORAGE CONFIGURATION ===
# Storage fetch order: comma-separated list of backends to try in order
# Options: r2, do, failover
# Examples:
#   "r2,do,failover"  - Try R2 first, then DO Spaces, then failover origin
#   "do,r2,failover"  - Try DO Spaces first, then R2, then failover origin
#   "r2,failover"     - R2 only with failover (no DO Spaces)
#   "do,failover"     - DO Spaces only with failover (no R2)
STORAGE_ORDER=r2,do,failover

# === CLOUDFLARE CREDENTIALS (Required) ===

# Cloudflare Account ID (from dashboard URL or R2 overview)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# === CLOUDFLARE WORKERS STATIC ASSETS ===
# Safe defaults upload nothing and never promote. Stages 1-3 enable shadow
# uploads while keeping REQUIRED and ALLOW_PROMOTION false. Stage 4 sets all
# three gates true only after the guarded promotion tests and route cutover pass.
CF_ASSETS_ENABLED=false
CF_ASSETS_REQUIRED=false
CF_ASSETS_ALLOW_PROMOTION=false
CF_ASSETS_WORKER_NAME=allium-metrics-assets
CF_ASSETS_PREVIEW_ALIAS=allium-candidate
CF_ASSETS_COMPATIBILITY_DATE=2026-07-26
CF_ASSETS_VERIFY_ATTEMPTS=3
CF_ASSETS_VERIFY_MAX_ATTEMPTS=12
CF_ASSETS_VERIFY_RETRY_DELAY=10
CF_ASSETS_VERIFY_CURL_TIMEOUT=60
# Retry only transient Wrangler upload/API failures. Every successful upload is
# parsed from Wrangler's structured output and verified by immutable preview URL.
CF_ASSETS_UPLOAD_MAX_ATTEMPTS=3
CF_ASSETS_UPLOAD_RETRY_DELAY=15
# A complete scheduled job exceeding this interval breaks the Stage 2 streak.
CF_ASSETS_MAX_JOB_SECONDS=1800
# When package.json, pnpm-lock.yaml or pnpm-workspace.yaml differ from the last
# verified install, the job runs pnpm install --frozen-lockfile before the
# Workers upload. A failed, timed-out, or mismatched install restores the
# previous node_modules, reverts any change it made to the checkout, and the job
# continues with the previous toolchain. The same lockfile is retried after
# CF_ASSETS_TOOLCHAIN_RETRY_SECONDS; a changed lockfile is tried at once. Set
# CF_ASSETS_TOOLCHAIN_AUTO_SYNC=false to install the toolchain manually.
CF_ASSETS_TOOLCHAIN_AUTO_SYNC=true
CF_ASSETS_TOOLCHAIN_INSTALL_TIMEOUT=180
CF_ASSETS_TOOLCHAIN_RETRY_SECONDS=3600
# When each Workers version is prepared, and again before its upload, count
# the files Wrangler would upload: refuse above the maximum files per Worker
# version, warn from the warning level.
# Unset, the main Worker warns from 98000 files, or 60000 with
# CHARTS_LAYOUT=charts; the charts Worker warns from CF_CHARTS_WARN_FILES.
CF_ASSETS_MAX_FILES=100000
# CF_ASSETS_WARN_FILES=

# Chart layout. beside (the default) writes the chart PNGs next to their relay
# and contact pages, served by the main Worker. charts writes them below
# charts/ and serves them from a second, charts-only Worker on the zone route
# <host>/charts/*; the main Worker then drops /charts/ and redirects the old
# chart URLs there with deploy-owned .assetsignore and _redirects files. The
# charts Worker must be bootstrapped and the route created before this is set
# to charts (see README). Switching either way moves almost every chart key in
# DO and R2 in the next build.
CHARTS_LAYOUT=beside
# The charts-only Worker; required for CHARTS_LAYOUT=charts.
CF_CHARTS_WORKER_NAME=
CF_CHARTS_PREVIEW_ALIAS=allium-charts-candidate
# Its directory, rebuilt every build as hard links to the charts: outside
# OUTPUT_DIR and on the same filesystem. Unset, it is the OUTPUT_DIR path
# followed by -charts-stage.
# CF_CHARTS_STAGE_DIR=
CF_CHARTS_WARN_FILES=85000
# true: when the charts Worker fails in a build that keeps the promoted
# layout, promote the main Worker anyway (charts new since the charts Worker's
# last good promotion then fail) and exit non-zero. Never applies to the build
# that switches the layout.
CF_CHARTS_ALLOW_STALE=false
# Emergency shed: true runs Allium with --no-charts, so pages show no charts
# and the tree drops every chart PNG, in either layout.
ALLIUM_NO_CHARTS=false

# Dead-man heartbeat: a healthchecks.io-style ping URL. Each job pings
# <url>/start, then <url> or <url>/fail (with the failure class; a Workers
# failure also when the job exits 0), and <url>/log for warnings. Unset, no
# ping is sent.
HEALTHCHECK_URL=

# Wrangler always writes full debug traces to its file sink regardless of the
# console level. The default path is a managed /dev/null symlink; actual errors
# remain visible in the bounded update.log. Set a different path only for a
# temporary debugging session. update.log is size-rotated.
# WRANGLER_LOG=info adds up to 100 changed-asset lines, one upload-progress
# line per 1,000 files, and one line per upload retry. Since Wrangler 4.93.1 the
# retry line omits the error and gateway throttling is logged only at debug
# level, so the reason for a retry is only in a real WRANGLER_LOG_PATH file.
# The upload summaries (logs/cfassets-uploads.tsv, logs/cfcharts-uploads.tsv)
# record the file counts Wrangler reports only at info level.
WRANGLER_LOG=error
WRANGLER_LOG_PATH=$HOME/allium-deploy/logs/wrangler-debug-sink.log
WRANGLER_LOG_SANITIZE=true
ALLIUM_UPDATE_LOG_MAX_BYTES=33554432
ALLIUM_UPDATE_LOG_ARCHIVES=3
WRANGLER_ERROR_LOG_MAX_BYTES=8388608
WRANGLER_ERROR_LOG_ARCHIVES=2

# === CLOUDFLARE R2 CONFIGURATION ===
# Required if 'r2' is in STORAGE_ORDER

# Enable R2 storage
R2_ENABLED=true

# R2 API Credentials (R2 → Manage R2 API Tokens → Create)
R2_ACCESS_KEY_ID=your_access_key_here
R2_SECRET_ACCESS_KEY=your_secret_key_here

# R2 bucket name
R2_BUCKET=my-metrics-content

# R2 binding name (used in Worker code: env.METRICS_CONTENT)
R2_BINDING_NAME=METRICS_CONTENT

# Live-content replication cadence. Keep every-build through the initial
# production soak; switch to daily only after its acceptance gate passes.
# Daily mode retries each scheduled run until upload plus verification succeed.
R2_CONTENT_SYNC_INTERVAL=every-build

# Comma-separated objects downloaded and SHA-256 checked after a daily live
# sync. Object count and total bytes are also compared before success is marked.
R2_CONTENT_VERIFY_PATHS=index.html,search-index.json,1aeo.com/index.html

# === DIGITALOCEAN SPACES CONFIGURATION ===
# Required if 'do' is in STORAGE_ORDER

# Enable DO Spaces storage
DO_ENABLED=false

# DO Spaces API Credentials (API → Spaces Keys → Generate New Key)
DO_SPACES_KEY=your_spaces_access_key_here
DO_SPACES_SECRET=your_spaces_secret_key_here

# DO Spaces region (nyc3, sfo3, ams3, sgp1, fra1)
DO_SPACES_REGION=nyc3

# DO Spaces bucket name
DO_SPACES_BUCKET=my-metrics-content

# DO Spaces CDN toggle (true = use CDN, false = use origin)
# CDN is faster but has ~1hr cache (no purge available)
# Origin is slower but always serves fresh content
DO_SPACES_CDN=false

# DO Spaces URL for Pages function
# This is auto-generated based on bucket/region, but you can override it
# Origin: https://{bucket}.{region}.digitaloceanspaces.com
# CDN:    https://{bucket}.{region}.cdn.digitaloceanspaces.com
DO_SPACES_URL=https://my-metrics-content.nyc3.digitaloceanspaces.com

# === CLOUDFLARE PAGES CONFIGURATION ===

# Pages project name (as shown in Cloudflare dashboard)
PAGES_PROJECT_NAME=my-metrics

# Wrangler compatibility date (YYYY-MM-DD)
WRANGLER_COMPATIBILITY_DATE=2025-12-01

# Pages build output directory
PAGES_BUILD_OUTPUT_DIR=public

# Site URL (for allium --base-url and Cloudflare CDN cache purge)
SITE_URL=https://metrics.example.com

# Direct Pages deployment used only to keep the rollback cache current while a
# Worker route fronts SITE_URL. Purge bodies still contain absolute SITE_URL
# cache keys. Leave equal to SITE_URL before the Worker-route cutover.
PAGES_PURGE_URL=https://my-metrics.pages.dev

# The Pages function derives its canonical Cache API origin from SITE_URL so
# the production hostname and direct pages.dev rollback checks use one key.
# Override only when the Pages rollback cache must represent another HTTPS
# origin; paths, queries, and fragments are rejected.
CACHE_KEY_ORIGIN=https://metrics.example.com

# Keep the dormant Pages rollback target current during the Worker-route soak.
# Stage 6 changes this to false only after the Worker Custom Domain passes the
# full production health gate. False disables both schema-triggered Pages
# deployments and the approximately 29,000-URL Pages purge loop.
PAGES_ROLLBACK_MAINTENANCE_ENABLED=true

# Run the approximately 29,000-URL Pages HTML purge loop after each build.
# A purge reaches only the one Cloudflare data center that handles this
# server's requests, and while a Worker route fronts SITE_URL almost nothing
# is cached on pages.dev, so the loop rarely deletes anything. HTML cached on
# pages.dev expires after CACHE_TTL_HTML anyway. False skips only that loop:
# the root page and search-index.json are still purged so the direct Pages
# rollback hash checks run from this server (run-cfassets-remediation-audit.sh,
# used by Stage 6) see the current build, and /metrics is still purged as
# before. Schema-triggered Pages deployments and Stage 6 are unaffected, and
# nothing is purged when PAGES_ROLLBACK_MAINTENANCE_ENABLED=false.
PAGES_BULK_PURGE_ENABLED=true

# === LOCAL PATHS ===

# Output directory for generated metrics
OUTPUT_DIR=$HOME/metrics-output

# Local backup directory
BACKUP_DIR=$HOME/metrics-backups

# Path to allium source
ALLIUM_DIR=$HOME/allium

# Path to rclone binary
RCLONE_PATH=$HOME/bin/rclone

# === SETTINGS ===

# Number of backups to keep
KEEP_BACKUPS=10

# Cron schedule (default: 15 and 45 past each hour)
CRON_SCHEDULE="15,45 * * * *"

# Rclone Performance Tuning - R2 (high parallelism, no rate limiting)
RCLONE_TRANSFERS=128
RCLONE_CHECKERS=256
RCLONE_BUFFER_SIZE=128M
RCLONE_S3_UPLOAD_CONCURRENCY=32
RCLONE_S3_CHUNK_SIZE=16M

# Rclone Performance Tuning - DO Spaces. DigitalOcean recommends optimizing
# workloads above roughly 150 requests/second. The transaction cap counts all
# HTTP operations (including PUT, HEAD, LIST, and DELETE) and keeps the
# small-file build below that threshold. It keeps rclone's upload integrity
# checks; only DO_RCLONE_NO_HEAD below skips the post-upload HEAD.
DO_RCLONE_TRANSFERS=56
DO_RCLONE_CHECKERS=80
DO_RCLONE_TPS_LIMIT=120
DO_RCLONE_TPS_LIMIT_BURST=1
# DigitalOcean recommends several small parallel connections. Disable S3
# HTTP/2 so rclone's workers are not multiplexed through one long-lived
# transport session.
DO_RCLONE_DISABLE_HTTP2=true
# Compare size plus the listing ETag (each single-part object's MD5) instead of
# reading every object's mtime with a HEAD request. Unchanged objects then cost
# no request and changed same-size objects skip the mtime HEAD. Uploads keep
# their post-upload integrity HEAD unless DO_RCLONE_NO_HEAD=true. Also passed
# to the DO local and remote backups, whose fresh destinations make it a no-op.
# Default false keeps modtime comparison. Set DO_RCLONE_NO_HEAD=false before
# turning this off; otherwise the DO live sync fails closed (exit 2) each build.
DO_RCLONE_CHECKSUM=false
# Skip the HEAD rclone sends after each live-sync upload to read the stored
# size and ETag back. A changed file then costs one PUT instead of two
# requests, saving about 4-5 minutes per build at the 120 operations/second
# cap. Requires DO_RCLONE_CHECKSUM=true; fails closed otherwise. Each upload is
# still checked: rclone sends Content-MD5 on every single-part PUT and DO
# rejects a mismatching body (400 BadDigest, previous object kept); rclone
# compares the PUT response ETag (the body's MD5) with the local MD5; and the
# next build's checksum listing compares every object's size and MD5 again.
# Trade-off: a stored object that differs despite a successful PUT is caught by
# that next build instead of immediately. Verified against this bucket on
# 2026-10-12; the HEAD caught 0 failures in ~98M uploads since 2026-08-01.
# Backups and R2 always keep the HEAD. Default false keeps it here too.
DO_RCLONE_NO_HEAD=false
# Comma-separated top-level page trees to sync one at a time with --fast-list.
# Each pass lists only its own prefix (one LIST per 1,000 objects instead of
# one per page folder) and never enumerates _backups/. A final
# directory-traversal pass covers root files and all other directories. A
# failed pass skips the remaining passes; the next build syncs everything.
# Empty keeps one traversal sync; ignored when DO_RCLONE_FAST_LIST=true.
# Production-sized trees: relay,contact,family,first_seen,as. Before switching
# CHARTS_LAYOUT, list charts first (charts,relay,contact,...): a switch either
# way then uploads the new chart keys before deleting the old ones.
DO_RCLONE_FAST_LIST_SUBTREES=

# Keep the daily DO remote snapshot off the every-build publication critical
# path. Leave true unless scripts/run-do-remote-backup.sh is installed as an
# independent hourly retry. The independent backup uses 30 operations/second;
# together with the 120-operation live mirror cap this stays at DigitalOcean's
# documented optimization threshold of roughly 150 requests/second. The
# shared I/O lock prevents the snapshot from overlapping live bucket mutation.
DO_REMOTE_BACKUP_INLINE=true
DO_REMOTE_BACKUP_TRANSFERS=16
DO_REMOTE_BACKUP_CHECKERS=32
DO_REMOTE_BACKUP_TPS_LIMIT=30
DO_REMOTE_BACKUP_TPS_LIMIT_BURST=1
DO_IO_LOCK_WAIT_SECONDS=180

# === BACKUP SETTINGS ===
# How often each backup runs:
#   daily      once per day (default). Later runs that day skip it.
#   every-run  on every upload run, copying the whole bucket each time.
#   off        never on scheduled runs. A manual --force-backup run of an
#              upload script still takes the backups that script runs itself.
# Any other value stops the upload before it starts.
# LOCAL_BACKUP_FREQUENCY covers the local copies in BACKUP_DIR. R2 and DO cover
# the _backups/ snapshot inside each bucket. With DO_REMOTE_BACKUP_INLINE=false
# the DO snapshot is taken only by scripts/run-do-remote-backup.sh, which does
# nothing when DO is off and takes at most one snapshot per day for every-run.
# In that mode the upload's --force-backup forces only the local backup; run
# allium-deploy-upload-do.sh --remote-backup-only --force-backup to take a DO
# snapshot now.
#
# The older DAILY_LOCAL_BACKUP, DAILY_R2_BACKUP and DAILY_DO_BACKUP still work
# while the matching setting here is unset, but false there means every-run,
# not off. When both are set, the setting here wins.
LOCAL_BACKUP_FREQUENCY=daily
R2_BACKUP_FREQUENCY=daily
DO_BACKUP_FREQUENCY=daily

# === FAILOVER CONFIGURATION ===
# Required if 'failover' is in STORAGE_ORDER
# Failover to an alternate origin if all storage backends fail

# Base URL for failover origin (e.g., nginx server with same content)
FAILOVER_ORIGIN_URL=

# === CLOUDFLARE CDN CACHE CONFIGURATION ===
# Cloudflare edge caching via the Pages function

# HTML pages: 30 min cache (Pages purge after each build: see
# PAGES_ROLLBACK_MAINTENANCE_ENABLED and PAGES_BULK_PURGE_ENABLED)
CACHE_TTL_HTML=1800

# Static assets (CSS, JS, images): 24 hour cache
CACHE_TTL_STATIC=86400

# Secret for Cloudflare CDN cache purge endpoint (POST /_purge with X-Purge-Secret header)
PURGE_SECRET=

# === SPARSE FALLBACK TELEMETRY ===
# Writes one Analytics Engine point only for an R2/failover response or when
# every content source fails. Normal DigitalOcean and static requests are not
# recorded. Data does not include full URLs, queries, IPs, or user agents.
SOURCE_EVENTS_ENABLED=false
SOURCE_EVENTS_DATASET=allium_source_events
